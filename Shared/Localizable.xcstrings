    "Français, anglais, allemand, espagnol, italien, portugais, japonais, russe, arabe, coréen et 20 autres langues. Le chinois utilise automatiquement une voix iPhone." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "الفرنسية والإنجليزية والألمانية والإسبانية والإيطالية والبرتغالية واليابانية والروسية والعربية والكورية و20 لغة أخرى. تستخدم الصينية تلقائيًا صوت iPhone." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Französisch, Englisch, Deutsch, Spanisch, Italienisch, Portugiesisch, Japanisch, Russisch, Arabisch, Koreanisch und 20 weitere Sprachen. Für Chinesisch wird automatisch eine iPhone-Stimme verwendet." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "French, English, German, Spanish, Italian, Portuguese, Japanese, Russian, Arabic, Korean, and 20 more languages. Chinese automatically uses an iPhone voice." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Francés, inglés, alemán, español, italiano, portugués, japonés, ruso, árabe, coreano y 20 idiomas más. El chino usa automáticamente una voz del iPhone." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Francese, inglese, tedesco, spagnolo, italiano, portoghese, giapponese, russo, arabo, coreano e altre 20 lingue. Il cinese usa automaticamente una voce iPhone." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "フランス語、英語、ドイツ語、スペイン語、イタリア語、ポルトガル語、日本語、ロシア語、アラビア語、韓国語、その他20言語に対応。中国語ではiPhoneの音声が自動的に使われます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "프랑스어, 영어, 독일어, 스페인어, 이탈리아어, 포르투갈어, 일본어, 러시아어, 아랍어, 한국어 및 20개 이상의 언어를 지원합니다. 중국어는 자동으로 iPhone 음성을 사용합니다." } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "Francês, inglês, alemão, espanhol, italiano, português, japonês, russo, árabe, coreano e mais 20 idiomas. O chinês usa automaticamente uma voz do iPhone." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Французский, английский, немецкий, испанский, итальянский, португальский, японский, русский, арабский, корейский и ещё 20 языков. Для китайского автоматически используется голос iPhone." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "支持法语、英语、德语、西班牙语、意大利语、葡萄牙语、日语、俄语、阿拉伯语、韩语及另外20种语言。中文会自动使用iPhone声音。" } }
      }
    },
    "Gardez Le Conteur ouvert pendant la préparation Qwen. Touchez Lire pour reprendre." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبقِ الراوي مفتوحًا أثناء إعداد Qwen. اضغط تشغيل للمتابعة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lassen Sie „Erzähler“ geöffnet, während Sie Qwen vorbereiten. Tippen Sie auf „Wiedergabe“, um fortzufahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep Storyteller open while Qwen prepares. Tap Play to resume."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén abierto Narrador mientras preparas Qwen. Toca Reproducir para reanudar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni aperto Narratore mentre prepari Qwen. Tocca Riproduci per riprendere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qwenの準備中は、語り手を開いたままにしてください。再開するには「再生」をタップします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qwen이 준비하는 동안 이야기꾼을 열어 두세요. 다시 시작하려면 재생을 탭하세요."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha Contador aberto enquanto prepara Qwen. Toque em Reproduzir para continuar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держите Рассказчик открытым, пока готовите Qwen. Нажмите «Воспроизвести», чтобы возобновить воспроизведение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qwen 准备期间请保持 讲述者 打开。轻点“播放”继续。"
          }
        }
      }
    },
    "Il y a des histoires qui commencent par un voyage. Celle-ci commence par une voix." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هناك قصص تبدأ برحلة. وهذا يبدأ بالصوت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt Geschichten, die mit einer Reise beginnen. Dies beginnt mit einer Stimme."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There are stories that begin with a journey. This begins with a voice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay historias que comienzan con un viaje. Esto comienza con una voz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ci sono storie che iniziano con un viaggio. Questo inizia con una voce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旅から始まる物語がある。これは声から始まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여행으로 시작되는 이야기가 있습니다. 이것은 목소리로 시작됩니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Há histórias que começam com uma viagem. Isso começa com uma voz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Есть истории, которые начинаются с путешествия. Все начинается с голоса."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有些故事是从一次旅行开始的。这要从一个声音开始。"
          }
        }
      }
    },
    "Imaginez un matin tranquille. La lumière glisse sur la table, le café est encore chaud et un livre vous attend. Vous n’avez pas besoin de tourner la page. Il vous suffit d’écouter." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تخيل صباح هادئ. ينزلق الضوء عبر الطاولة، والقهوة لا تزال ساخنة، وكتاب في انتظارك. لا تحتاج إلى قلب الصفحة. عليك فقط أن تستمع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellen Sie sich einen ruhigen Morgen vor. Das Licht gleitet über den Tisch, der Kaffee ist noch heiß und ein Buch erwartet Sie. Sie müssen nicht umblättern. Man muss nur zuhören."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imagine a quiet morning. The light slides across the table, the coffee is still hot and a book awaits you. You don't need to turn the page. You just have to listen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imagina una mañana tranquila. La luz se desliza sobre la mesa, el café aún está caliente y un libro te espera. No es necesario pasar página. Sólo tienes que escuchar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immagina una mattinata tranquilla. La luce scivola sul tavolo, il caffè è ancora caldo e un libro ti aspetta. Non è necessario voltare pagina. Devi solo ascoltare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "静かな朝を想像してみてください。光がテーブルを横切り、コーヒーはまだ熱く、本があなたを待っています。ページをめくる必要はありません。ただ聞くだけでいいのです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "조용한 아침을 상상해 보세요. 빛이 테이블 위로 미끄러지듯 지나가고 커피는 여전히 뜨겁고 책 한 권이 여러분을 기다리고 있습니다. 페이지를 넘길 필요가 없습니다. 당신은 듣기만 하면 됩니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imagine uma manhã tranquila. A luz desliza pela mesa, o café ainda está quente e um livro espera por você. Você não precisa virar a página. Você apenas tem que ouvir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Представьте себе тихое утро. Свет скользит по столу, кофе еще горячий, и вас ждет книга. Вам не нужно переворачивать страницу. Вам просто нужно слушать."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想象一下一个安静的早晨。灯光从桌子上滑过，咖啡仍然是热的，一本书正在等待着您。你不需要翻页。你只需要听。"
          }
        }
      }
    },
