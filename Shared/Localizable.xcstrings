          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يحتوي هذا المستند على نص قابل للقراءة. يحتاج ملف PDF الممسوح ضوئيًا إلى التعرّف البصري على الأحرف."
          }
        },
        "de" : {
          "stringUnit" : {
