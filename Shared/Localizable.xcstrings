          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El arte de narrar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’arte di raccontare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "物語を語るということ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
