            "value": "El placer de leer con los ojos cerrados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il piacere di leggere a occhi chiusi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
