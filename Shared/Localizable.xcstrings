    "Préparation arrêtée pour libérer de la mémoire. Réessayez sur un passage plus court." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقف الإعداد لتحرير الذاكرة. أعد المحاولة على مقطع أقصر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Vorbereitung wurde gestoppt, um Speicher freizugeben. Versuchen Sie es noch einmal mit einer kürzeren Passage."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preparation stopped to free memory. Try again with a shorter passage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La preparación se detuvo para liberar memoria. Inténtalo de nuevo en un pasaje más corto."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La preparazione si è interrotta per liberare memoria. Riprovare con un passaggio più breve."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモリを解放するために準備が停止されました。短いパッセージでもう一度試してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모리 확보를 위해 준비를 중단했습니다. 더 짧은 구절로 다시 시도하세요."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A preparação parou para liberar memória. Tente novamente em uma passagem mais curta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подготовка остановлена, чтобы освободить память. Попробуйте еще раз на более коротком отрывке."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为释放内存，准备过程已停止。请使用更短的段落重试。"
          }
        }
      }
    },
