    "Marquez une voix d’une étoile pour chaque langue. Votre choix est conservé lorsque vous écoutez une autre langue." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ميّز صوتًا بنجمة لكل لغة. يُحتفظ باختيارك عند الاستماع إلى لغة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markieren Sie eine Stimme für jede Sprache. Ihre Auswahl bleibt erhalten, wenn Sie eine andere Sprache hören."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Star one voice for each language. Your choice is preserved when you listen in another language."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Destaca una voz para cada idioma. Su elección se conserva cuando escucha otro idioma."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speciale una voce per ogni lingua. La tua scelta viene mantenuta quando ascolti un'altra lingua."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言語ごとに 1 つの音声にスターを付けます。別の言語を聞いても、選択は保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 언어에서 음성 하나에 별표를 지정하세요. 다른 언어를 들어도 선택이 유지됩니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marque uma voz para cada idioma. Sua escolha é mantida quando você ouve outro idioma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отметьте по одному голосу для каждого языка. Ваш выбор сохраняется, когда вы слушаете другой язык."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为每种语言标记一个星标声音。切换到其他语言朗读时，您的选择仍会保留。"
          }
        }
      }
    },
