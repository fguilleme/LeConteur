          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A passage wasn’t translated. Completed passages are preserved so you can try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pasaje no ha sido traducido. Los pasajes completados se guardan para volver a intentarlo."
