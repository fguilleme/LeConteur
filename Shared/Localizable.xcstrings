    "Le fichier Qwen %@ est incomplet ou invalide. Relancez l’installation.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Qwen file %@ is incomplete or invalid. Restart the installation."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Qwen 파일 %@이(가) 불완전하거나 유효하지 않습니다. 설치를 다시 시작하세요."
          }
        },
        "zh-Hans": {
