    "Le partage n’est pas configuré. Activez le groupe d’applications dans les deux cibles Xcode.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المشاركة غير مهيأة. فعّل مجموعة التطبيقات في هدفي Xcode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Teilen ist nicht eingerichtet. Aktiviere die App-Gruppe in beiden Xcode-Targets."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing isn’t configured. Enable the app group in both Xcode targets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartir no está configurado. Activa el grupo de apps en ambos objetivos de Xcode."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La condivisione non è configurata. Attiva il gruppo app in entrambi i target Xcode."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有が設定されていません。両方のXcodeターゲットでApp Groupを有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유가 구성되지 않았습니다. 두 Xcode 타깃에서 앱 그룹을 활성화하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A partilha não está configurada. Ative o grupo de aplicações nos dois alvos do Xcode."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Общий доступ не настроен. Включите группу приложений в обеих целях Xcode."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享尚未配置。请在两个 Xcode 目标中启用 App Group。"
          }
        }
      }
    },
    "Le plaisir de lire, les yeux fermés.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متعة القراءة بعينين مغمضتين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lesegenuss mit geschlossenen Augen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The joy of reading with your eyes closed."
          }
        },
        "es": {
          "stringUnit": {
