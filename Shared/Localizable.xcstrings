    "Le partage n’est pas configuré. Activez le groupe d’applications dans les deux cibles Xcode." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المشاركة غير مهيأة. فعّل مجموعة التطبيقات في هدفي Xcode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Teilen ist nicht eingerichtet. Aktiviere die App-Gruppe in beiden Xcode-Targets."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sharing isn’t configured. Enable the app group in both Xcode targets."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartir no está configurado. Activa el grupo de apps en ambos objetivos de Xcode."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La condivisione non è configurata. Attiva il gruppo app in entrambi i target Xcode."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有が設定されていません。両方のXcodeターゲットでApp Groupを有効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유가 구성되지 않았습니다. 두 Xcode 타깃에서 앱 그룹을 활성화하세요."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A partilha não está configurada. Ative o grupo de aplicações nos dois alvos do Xcode."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Общий доступ не настроен. Включите группу приложений в обеих целях Xcode."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共享尚未配置。请在两个 Xcode 目标中启用 App Group。"
          }
        }
      }
    },
    "Le plaisir de lire, les yeux fermés." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متعة القراءة بعينين مغمضتين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lesegenuss mit geschlossenen Augen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The joy of reading with your eyes closed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El placer de leer con los ojos cerrados."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il piacere di leggere a occhi chiusi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目を閉じて読書を楽しむ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "눈을 감고 즐기는 독서."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O prazer de ler de olhos fechados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удовольствие от чтения с закрытыми глазами."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "闭上眼睛，享受阅读。"
          }
        }
      }
    },
    "Le téléchargement continue en Wi-Fi quand vous changez d’app ou éteignez l’écran. Les fichiers terminés sont conservés si vous l’interrompez." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستمر التنزيل عبر Wi‑Fi عند الانتقال إلى تطبيق آخر أو إطفاء الشاشة. تُحفظ الملفات المكتملة إذا أوقفت التنزيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Download wird über WLAN fortgesetzt, wenn Sie die App wechseln oder den Bildschirm ausschalten. Abgeschlossene Dateien bleiben erhalten, wenn Sie den Vorgang unterbrechen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The download continues over Wi-Fi when you switch apps or turn off the screen. Completed files are kept if you interrupt it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La descarga continúa a través de Wi-Fi cuando cambias de aplicación o apagas la pantalla. Los archivos completos se conservan si los interrumpe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il download continua tramite Wi-Fi quando cambi app o spegni lo schermo. I file completati vengono conservati se lo interrompi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを切り替えたり、画面をオフにしても、ダウンロードは Wi-Fi 経由で続行されます。中断しても、完了したファイルは保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 앱으로 전환하거나 화면을 꺼도 Wi-Fi에서 다운로드가 계속됩니다. 중단해도 완료된 파일은 유지됩니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O download continua por Wi-Fi quando você troca de aplicativo ou desliga a tela. Os arquivos concluídos serão retidos se você interrompê-los."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загрузка продолжается по Wi-Fi, когда вы переключаете приложения или выключаете экран. Завершенные файлы сохраняются, если вы их прервете."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换应用或关闭屏幕后，下载仍会通过 Wi-Fi 继续。即使中断，已完成下载的文件也会保留。"
          }
        }
      }
    },
    "Le téléchargement continue en Wi‑Fi quand vous changez d’app ou éteignez l’écran." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "يستمر التنزيل عبر Wi‑Fi عند تبديل التطبيقات أو إطفاء الشاشة." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Download läuft über WLAN weiter, wenn du die App wechselst oder den Bildschirm ausschaltest." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The download continues over Wi‑Fi when you switch apps or turn off the screen." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "La descarga continúa por Wi‑Fi al cambiar de app o apagar la pantalla." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Il download continua tramite Wi‑Fi quando cambi app o spegni lo schermo." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "アプリを切り替えたり画面を消したりしても、Wi‑Fi 経由でダウンロードが続きます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "앱을 전환하거나 화면을 꺼도 Wi‑Fi에서 다운로드가 계속됩니다." } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "A descarga continua por Wi‑Fi ao mudar de aplicação ou desligar o ecrã." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Загрузка по Wi‑Fi продолжится при смене приложения или выключении экрана." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "切换应用或关闭屏幕时，下载会通过 Wi‑Fi 继续。" } }
      }
    },
    "Le texte « Le goût des mots » est un texte de démonstration original créé pour Le Conteur." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نص «Le goût des mots» هو نص تجريبي أصلي أُنشئ لتطبيق الراوي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Le goût des mots“ ist ein eigens für Erzähler verfasster Beispieltext."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Le goût des mots” is an original sample text created for Storyteller."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Le goût des mots» es un texto de demostración original creado para Narrador."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Le goût des mots» è un testo dimostrativo originale creato per Narratore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「Le goût des mots」は語り手のために作成されたオリジナルのサンプルテキストです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘Le goût des mots’는 이야기꾼을 위해 제작된 오리지널 예시 텍스트입니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Le goût des mots» é um texto de demonstração original criado para o Contador."
          }
        },
        "ru" : {
