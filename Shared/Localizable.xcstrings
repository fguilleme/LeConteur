    "La mémoire disponible est insuffisante pour Qwen. Fermez les autres apps puis réessayez, ou choisissez une voix iPhone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الذاكرة المتاحة غير كافية لتشغيل Qwen. أغلق التطبيقات الأخرى ثم أعد المحاولة، أو اختر صوت iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Qwen ist nicht genügend Speicher verfügbar. Schließen Sie andere Apps und versuchen Sie es erneut oder wählen Sie eine iPhone-Stimme."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There isn’t enough available memory for Qwen. Close other apps and try again, or choose an iPhone voice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay suficiente memoria disponible para Qwen. Cierra otras aplicaciones e inténtalo de nuevo, o elige una voz de iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La memoria disponibile per Qwen non è sufficiente. Chiudi le altre app e riprova oppure scegli una voce per iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qwen に使用できるメモリが不足しています。他のアプリを閉じて再試行するか、iPhone の音声を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qwen에 사용할 수 있는 메모리가 부족합니다. 다른 앱을 닫고 다시 시도하거나 iPhone 음성을 선택하세요."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há memória suficiente disponível para Qwen. Feche outros aplicativos e tente novamente ou escolha uma voz do iPhone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для Qwen недостаточно памяти. Закройте другие приложения и повторите попытку или выберите голос iPhone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可用内存不足，无法运行 Qwen。请关闭其他应用后重试，或选择 iPhone 声音。"
          }
        }
      }
    },
