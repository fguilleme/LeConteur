        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 PDF는 암호로 보호되어 있습니다. 가져오기 전에 잠금을 해제하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 PDF 受密码保护。请先解锁再导入。"
          }
        }
      }
    },
