    "Un passage n’a pas été traduit. Les passages terminés sont conservés pour réessayer." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُترجم أحد المقاطع. تم الاحتفاظ بالمقاطع المكتملة لإعادة المحاولة."
