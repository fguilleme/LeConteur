          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未知语言"
          }
        }
      }
    },
    "Langue ou voix": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language or voice"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언어 또는 음성"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语言或声音"
          }
        }
      }
    },
    "Langues prises en charge : français, anglais, espagnol, allemand, italien, portugais, russe, japonais, coréen et chinois.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اللغات المدعومة: الفرنسية والإنجليزية والإسبانية والألمانية والإيطالية والبرتغالية والروسية واليابانية والكورية والصينية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterstützte Sprachen: Französisch, Englisch, Spanisch, Deutsch, Italienisch, Portugiesisch, Russisch, Japanisch, Koreanisch und Chinesisch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supported languages: French, English, Spanish, German, Italian, Portuguese, Russian, Japanese, Korean, and Chinese."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Idiomas compatibles: francés, inglés, español, alemán, italiano, portugués, ruso, japonés, coreano y chino."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingue supportate: francese, inglese, spagnolo, tedesco, italiano, portoghese, russo, giapponese, coreano e cinese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応言語：フランス語、英語、スペイン語、ドイツ語、イタリア語、ポルトガル語、ロシア語、日本語、韓国語、中国語。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지원 언어: 프랑스어, 영어, 스페인어, 독일어, 이탈리아어, 포르투갈어, 러시아어, 일본어, 한국어, 중국어."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Idiomas compatíveis: francês, inglês, espanhol, alemão, italiano, português, russo, japonês, coreano e chinês."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поддерживаемые языки: французский, английский, испанский, немецкий, итальянский, португальский, русский, японский, корейский и китайский."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持的语言：法语、英语、西班牙语、德语、意大利语、葡萄牙语、俄语、日语、韩语和中文。"
          }
        }
