    "Ajoutez des voix de qualité améliorée dans Réglages → Accessibilité → Lire et énoncer → Voix. Le nom du menu peut varier selon iOS." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف أصواتًا محسّنة الجودة من الإعدادات ← تسهيلات الاستخدام ← المحتوى المنطوق ← الأصوات. قد يختلف اسم القائمة حسب إصدار iOS."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie Stimmen in verbesserter Qualität unter „Einstellungen“ → „Bedienungshilfen“ → „Lesen und Sprechen“ → „Stimmen“ hinzu. Der Menüname kann je nach iOS variieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add enhanced-quality voices in Settings → Accessibility → Spoken Content → Voices. The menu name may vary depending on iOS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agregue voces de calidad mejorada en Configuración → Accesibilidad → Leer y hablar → Voces. El nombre del menú puede variar según iOS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi voci di qualità migliorata in Impostazioni → Accessibilità → Leggi e parla → Voci. Il nome del menu può variare a seconda di iOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定」→「アクセシビリティ」→「読み上げと読み上げ」→「音声」で、品質が向上した音声を追加します。 iOSによってメニュー名が異なる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 → 손쉬운 사용 → 콘텐츠 말하기 → 음성에서 고품질 음성을 추가하세요. 메뉴 이름은 iOS 버전에 따라 다를 수 있습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione vozes de qualidade aprimorada em Configurações → Acessibilidade → Ler e falar → Vozes. O nome do menu pode variar dependendo do iOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте голоса улучшенного качества в «Настройки» → «Специальные возможности» → «Чтение и речь» → «Голоса». Название меню может отличаться в зависимости от iOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以前往“设置”→“辅助功能”→“朗读内容”→“声音”，添加增强品质的声音。菜单名称可能因 iOS 版本而异。"
          }
        }
      }
    },
