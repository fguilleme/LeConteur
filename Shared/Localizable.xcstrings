    "Ce document ne contient pas de texte lisible. Pour un PDF scanné, une reconnaissance de caractères est nécessaire.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This document contains no readable text. A scanned PDF requires optical character recognition."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 문서에 읽을 수 있는 텍스트가 없습니다. 스캔한 PDF에는 문자 인식이 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文档不包含可读取的文本。扫描版 PDF 需要先进行文字识别。"
          }
        }
      }
    },
    "Ce livre EPUB est endommagé, protégé ou n’utilise pas un format pris en charge.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This EPUB is damaged, protected, or uses an unsupported format."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 EPUB은 손상되었거나 보호되어 있거나 지원되지 않는 형식입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 EPUB 书籍已损坏、受保护或使用了不支持的格式。"
          }
        }
      }
    },
    "Ce PDF est protégé par un mot de passe. Déverrouillez-le avant de l’importer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This PDF is password-protected. Unlock it before importing it."
