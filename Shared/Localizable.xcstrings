    "Les poids officiels épinglés sont vérifiés avant installation. Le moteur fonctionne ensuite entièrement hors ligne." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "يتم التحقق من الأوزان الرسمية المحددة قبل التثبيت. بعدها يعمل المحرك دون اتصال بالكامل." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die festgelegten offiziellen Gewichte werden vor der Installation geprüft. Danach arbeitet die Engine vollständig offline." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The pinned official weights are verified before installation. The engine then works entirely offline." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Los pesos oficiales fijados se verifican antes de la instalación. Después, el motor funciona sin conexión." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "I pesi ufficiali selezionati vengono verificati prima dell’installazione. Il motore funziona poi completamente offline." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "指定された公式ウェイトはインストール前に検証されます。その後、エンジンは完全にオフラインで動作します。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "고정된 공식 가중치를 설치 전에 확인합니다. 이후 엔진은 완전히 오프라인으로 작동합니다." } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "Os pesos oficiais fixados são verificados antes da instalação. Depois, o motor funciona totalmente offline." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Закреплённые официальные веса проверяются перед установкой. Затем движок работает полностью офлайн." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "安装前会验证固定版本的官方权重。之后引擎可完全离线运行。" } }
      }
    },
