    "Qwen n’a pas produit d’audio utilisable. Réessayez sur un passage plus court." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم ينتج Qwen صوتًا قابلًا للاستخدام. أعد المحاولة على مقطع أقصر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qwen hat kein brauchbares Audio produziert. Versuchen Sie es noch einmal mit einer kürzeren Passage."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qwen didn’t produce usable audio. Try again with a shorter passage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qwen no produjo audio utilizable. Inténtalo de nuevo en un pasaje más corto."
