    "Installez d’abord Qwen dans Voix.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install Qwen in Voices first."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
