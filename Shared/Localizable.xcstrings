    "Choisissez votre façon d’écouter.\nLe même plaisir, sans connexion.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر طريقتك في الاستماع.\nالمتعة نفسها، دون اتصال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, wie du hören möchtest.\nDerselbe Genuss, ganz ohne Internet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how you listen.\nThe same enjoyment, offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cómo escuchar.\nEl mismo placer, sin conexión."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli come ascoltare.\nLo stesso piacere, offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "聴き方を選びましょう。\nオフラインでも同じ楽しさ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "듣는 방식을 선택하세요.\n같은 즐거움을, 인터넷 연결 없이."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha como ouvir.\nO mesmo prazer, sem ligação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите способ прослушивания.\nТо же удовольствие без интернета."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择您的聆听方式。\n离线也能尽享乐趣。"
          }
        }
      }
    },
