          "stringUnit" : {
            "state" : "translated",
            "value" : "ملف Qwen %@ غير مكتمل أو غير صالح. أعد التثبيت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Qwen %@-Datei ist unvollständig oder ungültig. Starten Sie die Installation neu."
          }
        },
        "en" : {
