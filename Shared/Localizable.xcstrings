    "Un passage n’a pas été traduit. Les passages terminés sont conservés pour réessayer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A passage wasn’t translated. Completed passages are preserved so you can try again."
          }
        },
        "ko": {
          "stringUnit": {
